# Ignore Python cache
__pycache__/
*.pyc

# Ignore __pycache__ folders in all apps
backend/apps/**/__pycache__/

# (Optional) ignore compiled migrations cache explicitly
backend/apps/**/migrations/__pycache__/*.pyc

# Ignore all Django migration files (all apps)
backend/apps/**/migrations/*.py

# But keep __init__.py
!backend/apps/**/migrations/__init__.py

# Environment variables
backend/core/.env

# SQLite database inside backend
backend/*.sqlite3
backend/*.db
backend/**/db.sqlite3